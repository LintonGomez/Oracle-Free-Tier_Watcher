# Copy to a protected path outside the repository and replace all examples.
# Never commit your real configuration to this public repository.

OCI_CLI="/home/ubuntu/bin/oci"
OCI_CONFIG_FILE="/home/ubuntu/.oci/config"
OCI_PROFILE="DEFAULT"

REGION="REPLACE_WITH_REGION"
COMPARTMENT_ID="ocid1.compartment.oc1..REPLACE_LOCALLY"
INSTANCE_NAME="REPLACE_WITH_INSTANCE_NAME"
SHAPE="VM.Standard.A1.Flex"
OCPUS="2"
MEMORY_GB="12"
BOOT_GB="50"

IMAGE_ID="ocid1.image.oc1.REPLACE_LOCALLY"
SUBNET_ID="ocid1.subnet.oc1.REPLACE_LOCALLY"
SSH_PUBLIC_KEY_FILE="/path/to/local/public-key.pub"

LOG_DIR="/var/log/oracle-free-tier-watcher"
STATE_DIR="/var/lib/oracle-free-tier-watcher"

RETRY_BASE_SECONDS="120"
RETRY_JITTER_SECONDS="30"
API_THROTTLE_BACKOFF_SECONDS="600"
CONFIG_ERROR_BACKOFF_SECONDS="1800"
INSTANCE_LIST_ERROR_BACKOFF_SECONDS="300"
LAUNCH_TIMEOUT_SECONDS="900"

# Keep false until configuration is validated. When false, the script queries
# for an existing instance and logs that a launch would be attempted, but
# never creates cloud resources.
DRY_RUN="true"

# Space-separated OCI availability-domain names, configured locally after
# querying the target region. Keep empty to use the default availability domain
# selected by OCI or configure exact valid values.
AVAILABILITY_DOMAINS=""
