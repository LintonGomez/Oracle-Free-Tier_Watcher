[Unit]
Description=Oracle Free Tier Capacity Watcher
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/oracle-free-tier-watcher/watcher.env

[Service]
Type=oneshot
User=oracle-watcher
Group=oracle-watcher
EnvironmentFile=/etc/oracle-free-tier-watcher/watcher.env
ExecStart=/opt/oracle-free-tier-watcher/src/oracle-free-tier-watcher.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# This watcher intentionally runs until success/manual stop; no implicit restart.
TimeoutStartSec=infinity
Restart=no
ReadWritePaths=/var/log/oracle-free-tier-watcher /var/lib/oracle-free-tier-watcher

[Install]
WantedBy=multi-user.target
